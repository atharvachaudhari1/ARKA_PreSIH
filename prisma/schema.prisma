// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

// Removed Gender enum in favor of decoupled String field

enum VerificationStatus {
  pending
  verified
  rejected
}

enum VerificationMethod {
  auto
  manual_review
}

enum ContactVisibility {
  public_to_logged_in
  team_only
  private
}

enum Proficiency {
  beginner
  intermediate
  advanced
  expert
}

enum TeamStatus {
  open
  full
  dissolved
}

enum SuccessionMode {
  manual
  auto_promote
}

enum MemberRole {
  leader
  member
}

enum RequestDirection {
  user_to_team
  team_to_user
}

enum RequestStatus {
  pending
  accepted
  rejected
  expired
  cancelled
}

enum ExpiredReason {
  timeout
  requester_joined_another_team
  team_full
}

enum Opinion {
  approve
  reject
  neutral
}

enum NotificationType {
  new_join_request
  teammate_opinion_added
  leader_decision_made
  request_accepted
  request_rejected
  request_expired_other_team_joined
  team_now_full
  team_dissolved
}

enum NotificationReadStatus {
  unread
  read
}

enum ReportReason {
  spam
  harassment
  inappropriate_content
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  // Supabase Auth links — auth_user_id is the UUID from Supabase Auth
  auth_user_id String  @unique
  email        String  @unique
  name         String
  department   String?
  college      String?

  // ID card — stored in private Supabase Storage bucket.
  // [GAP-RESOLVED-6] NEVER returned by any public API route.
  id_card_storage_path String?
  verification_status  VerificationStatus  @default(pending)
  verification_method  VerificationMethod?
  verified_at          DateTime?

  // OCR Verification Fields
  ocr_parsed_name       String?
  ocr_parsed_department String?
  ocr_parsed_college    String?
  ocr_confidence_score  Float?

  // Decoupled gender field: users can specify freely.
  gender                     String?
  // Quota flag: strictly evaluated for SIH validation (e.g. true for 'female')
  counts_toward_female_quota Boolean @default(false)

  // Contact — leader's fields forced public_to_logged_in while leading.
  phone_number                 String?
  whatsapp_number              String?
  linkedin_url                 String?
  github_url                   String?
  resume_storage_path          String?
  preferred_contact_visibility ContactVisibility @default(private)

  // Profile
  past_hackathons_count     Int     @default(0)
  bio                       String?
  presentation_skill_rating Int? // 1-5 self-rating

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Admin Flag
  is_admin Boolean @default(false)

  // Relations
  skills           UserSkill[]
  team_memberships TeamMembership[]
  led_teams        Team[]                   @relation("TeamLeader")
  sent_requests    JoinRequest[]            @relation("RequesterRequests")
  final_decisions  JoinRequest[]            @relation("DecisionMaker")
  opinions         JoinRequestOpinion[]
  notifications    Notification[]
  chat_messages    ChatMessage[]
  reports_made     Report[]                 @relation("Reporter")
  reports_received Report[]                 @relation("ReportedUser")
  ocr_attempts     OcrVerificationAttempt[]
  team_slots       TeamSlot[]
  email_otps       EmailVerificationOTP[]

  @@index([verification_status])
  @@map("users")
}

model OcrVerificationAttempt {
  id                    String   @id @default(cuid())
  user_id               String
  ocr_parsed_name       String?
  ocr_parsed_department String?
  ocr_parsed_college    String?
  ocr_confidence_score  Float?
  created_at            DateTime @default(now())
  expires_at            DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("ocr_verification_attempts")
}

model UserSkill {
  id          String      @id @default(cuid())
  user_id     String
  skill       String
  proficiency Proficiency @default(intermediate)
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, skill])
  @@map("user_skills")
}

// ─────────────────────────────────────────────
// Event (configurable per hackathon — NFR1)
// ─────────────────────────────────────────────

model Event {
  id                    String    @id @default(cuid())
  name                  String // e.g. "SIH 2026"
  team_size_max         Int // e.g. 6
  // [GAP-RESOLVED-2] Only 'female' counts toward this minimum.
  min_female_required   Int       @default(1)
  registration_deadline DateTime?
  themes                String[] // Array of theme strings
  is_active             Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  teams Team[]

  @@map("events")
}

// ─────────────────────────────────────────────
// Team
// ─────────────────────────────────────────────

model Team {
  id                      String  @id @default(cuid())
  event_id                String
  // [GAP-RESOLVED-1] leader_id always matches the TeamMembership with role=leader.
  leader_id               String
  name                    String
  description             String?
  domain_interest         String?
  min_experience_required Int?

  // skills_needed is explicit; skills_covered is derived at query time
  skills_needed String[]

  // [GAP-RESOLVED-2] gender_requirement is derived at query time using formula:
  // needed_female = max(0, event.min_female_required - count(female members))
  // Stored for efficient filtering; recomputed on membership changes.
  needed_female_count Int @default(1)

  status          TeamStatus     @default(open)
  // [GAP-RESOLVED-8] auto_promote algorithm: TBD — to be defined before Phase 5 starts.
  succession_mode SuccessionMode @default(manual)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  event            Event            @relation(fields: [event_id], references: [id])
  leader           User             @relation("TeamLeader", fields: [leader_id], references: [id])
  memberships      TeamMembership[]
  join_requests    JoinRequest[]
  notifications    Notification[]
  chat_messages    ChatMessage[]
  reports_received Report[]
  slots            TeamSlot[]

  @@index([status])
  @@index([event_id])
  @@map("teams")
}

model TeamMembership {
  id        String     @id @default(cuid())
  team_id   String
  user_id   String
  // [GAP-RESOLVED-1] Creator of team always gets role=leader.
  role      MemberRole @default(member)
  joined_at DateTime   @default(now())

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id, role])
  @@map("team_memberships")
}

model TeamSlot {
  id                String   @id @default(cuid())
  team_id           String
  role_title        String?
  gender            String   @default("any") // "male", "female", "any"
  skills            String[]
  is_filled         Boolean  @default(false)
  filled_by_user_id String?

  team Team  @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user User? @relation(fields: [filled_by_user_id], references: [id])

  @@map("team_slots")
}

// ─────────────────────────────────────────────
// Join Request
// ─────────────────────────────────────────────

model JoinRequest {
  id             String           @id @default(cuid())
  team_id        String
  requester_id   String
  direction      RequestDirection @default(user_to_team)
  status         RequestStatus    @default(pending)
  expired_reason ExpiredReason? // null unless status=expired

  // [GAP-RESOLVED-3] NO profile snapshot stored. Team always reads live User record.
  // [GAP-RESOLVED-5] DB-level partial unique index prevents duplicate pending requests.

  final_decision_by String? // FK -> User (must be team's leader_id at time of decision)
  created_at        DateTime  @default(now())
  resolved_at       DateTime?

  // Relations
  team           Team                 @relation(fields: [team_id], references: [id], onDelete: Cascade)
  requester      User                 @relation("RequesterRequests", fields: [requester_id], references: [id], onDelete: Cascade)
  decision_maker User?                @relation("DecisionMaker", fields: [final_decision_by], references: [id])
  opinions       JoinRequestOpinion[]

  @@index([team_id, requester_id])
  @@index([status])
  @@map("join_requests")
}

// Advisory only — never auto-decides outcome
model JoinRequestOpinion {
  id              String   @id @default(cuid())
  join_request_id String
  team_member_id  String
  opinion         Opinion
  comment         String?
  created_at      DateTime @default(now())

  join_request JoinRequest @relation(fields: [join_request_id], references: [id], onDelete: Cascade)
  team_member  User        @relation(fields: [team_member_id], references: [id], onDelete: Cascade)

  @@unique([join_request_id, team_member_id])
  @@map("join_request_opinions")
}

// ─────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────

model Notification {
  id          String                 @id @default(cuid())
  user_id     String
  team_id     String? // Optional context reference
  type        NotificationType
  payload     Json // JSONB — structured per notification type
  read_status NotificationReadStatus @default(unread)
  created_at  DateTime               @default(now())

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [team_id], references: [id], onDelete: SetNull)

  @@index([user_id, read_status])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// Chat Message
// ─────────────────────────────────────────────

model ChatMessage {
  id         String   @id @default(cuid())
  team_id    String
  sender_id  String
  content    String
  created_at DateTime @default(now())

  team   Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  sender User @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([team_id, created_at])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────
// Report
// ─────────────────────────────────────────────

model Report {
  id               String       @id @default(cuid())
  reporter_id      String
  reported_user_id String?
  reported_team_id String?
  reason           ReportReason
  description      String?
  status           ReportStatus @default(open)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  reporter      User  @relation("Reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported_user User? @relation("ReportedUser", fields: [reported_user_id], references: [id], onDelete: Cascade)
  reported_team Team? @relation(fields: [reported_team_id], references: [id], onDelete: Cascade)

  // Partial unique indexes implemented in raw SQL migration:
  // CREATE UNIQUE INDEX reports_active_user_idx ON reports(reporter_id, reported_user_id) WHERE status = 'open';
  // CREATE UNIQUE INDEX reports_active_team_idx ON reports(reporter_id, reported_team_id) WHERE status = 'open';
  @@map("reports")
}

model EmailVerificationOTP {
  id         String   @id @default(cuid())
  user_id    String
  email      String
  otp        String
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, email])
  @@map("email_verification_otps")
}
