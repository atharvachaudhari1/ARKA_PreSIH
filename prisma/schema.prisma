// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Gender {
  male
  female
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum ContactVisibility {
  public_to_logged_in
  team_only
  private
}

enum Proficiency {
  beginner
  intermediate
  advanced
  expert
}

enum TeamStatus {
  open
  full
}

enum SuccessionMode {
  manual
  auto_promote
}

enum MemberRole {
  leader
  member
}

enum RequestDirection {
  user_to_team
  team_to_user
}

enum RequestStatus {
  pending
  accepted
  rejected
  expired
}

enum ExpiredReason {
  timeout
  requester_joined_another_team
}

enum Opinion {
  approve
  reject
  neutral
}

enum NotificationType {
  new_join_request
  teammate_opinion_added
  leader_decision_made
  request_accepted
  request_rejected
  request_expired_other_team_joined
  team_now_full
}

enum NotificationReadStatus {
  unread
  read
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id                   String             @id @default(cuid())
  // Supabase Auth links — auth_user_id is the UUID from Supabase Auth
  auth_user_id         String             @unique
  email                String             @unique
  name                 String
  department           String?
  college              String?

  // ID card — stored in private Supabase Storage bucket.
  // [GAP-RESOLVED-6] NEVER returned by any public API route.
  id_card_storage_path String?
  verification_status  VerificationStatus @default(pending)

  // [GAP-RESOLVED-2] Binary male/female for SIH MVP.
  gender               Gender?

  // Contact — leader's fields forced public_to_logged_in while leading.
  phone_number         String?
  whatsapp_number      String?
  linkedin_url         String?
  contact_visibility   ContactVisibility  @default(private)

  // Profile
  past_hackathons_count    Int     @default(0)
  bio                      String?
  presentation_skill_rating Int?   // 1-5 self-rating

  // Timestamps
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  // Relations
  skills               UserSkill[]
  team_memberships     TeamMembership[]
  led_teams            Team[]             @relation("TeamLeader")
  sent_requests        JoinRequest[]      @relation("RequesterRequests")
  final_decisions      JoinRequest[]      @relation("DecisionMaker")
  opinions             JoinRequestOpinion[]
  notifications        Notification[]

  @@map("users")
}

model UserSkill {
  id          String      @id @default(cuid())
  user_id     String
  skill       String
  proficiency Proficiency @default(intermediate)
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, skill])
  @@map("user_skills")
}

// ─────────────────────────────────────────────
// Event (configurable per hackathon — NFR1)
// ─────────────────────────────────────────────

model Event {
  id                    String   @id @default(cuid())
  name                  String   // e.g. "SIH 2026"
  team_size_max         Int      // e.g. 6
  // [GAP-RESOLVED-2] Only 'female' counts toward this minimum.
  min_female_required   Int      @default(1)
  registration_deadline DateTime?
  themes                String[] // Array of theme strings
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  teams                 Team[]

  @@map("events")
}

// ─────────────────────────────────────────────
// Team
// ─────────────────────────────────────────────

model Team {
  id             String         @id @default(cuid())
  event_id       String
  // [GAP-RESOLVED-1] leader_id always matches the TeamMembership with role=leader.
  leader_id      String
  name           String
  description    String?
  domain_interest String?

  // skills_needed is explicit; skills_covered is derived at query time
  skills_needed  String[]

  // [GAP-RESOLVED-2] gender_requirement is derived at query time using formula:
  // needed_female = max(0, event.min_female_required - count(female members))
  // Stored for efficient filtering; recomputed on membership changes.
  needed_female_count Int @default(1)

  status          TeamStatus     @default(open)
  // [GAP-RESOLVED-8] auto_promote algorithm: TBD — to be defined before Phase 5 starts.
  succession_mode SuccessionMode @default(manual)

  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  // Relations
  event           Event          @relation(fields: [event_id], references: [id])
  leader          User           @relation("TeamLeader", fields: [leader_id], references: [id])
  memberships     TeamMembership[]
  join_requests   JoinRequest[]
  notifications   Notification[]

  @@map("teams")
}

model TeamMembership {
  id        String     @id @default(cuid())
  team_id   String
  user_id   String
  // [GAP-RESOLVED-1] Creator of team always gets role=leader.
  role      MemberRole @default(member)
  joined_at DateTime   @default(now())

  team      Team       @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_memberships")
}

// ─────────────────────────────────────────────
// Join Request
// ─────────────────────────────────────────────

model JoinRequest {
  id           String           @id @default(cuid())
  team_id      String
  requester_id String
  direction    RequestDirection @default(user_to_team)
  status       RequestStatus    @default(pending)
  expired_reason ExpiredReason? // null unless status=expired

  // [GAP-RESOLVED-3] NO profile snapshot stored. Team always reads live User record.
  // [GAP-RESOLVED-5] DB-level partial unique index prevents duplicate pending requests.

  final_decision_by String? // FK -> User (must be team's leader_id at time of decision)
  created_at        DateTime @default(now())
  resolved_at       DateTime?

  // Relations
  team          Team       @relation(fields: [team_id], references: [id], onDelete: Cascade)
  requester     User       @relation("RequesterRequests", fields: [requester_id], references: [id], onDelete: Cascade)
  decision_maker User?     @relation("DecisionMaker", fields: [final_decision_by], references: [id])
  opinions      JoinRequestOpinion[]

  // [GAP-RESOLVED-5] Partial unique index: only one pending request per (team, requester).
  // Implemented as a raw SQL index in a migration; Prisma @@unique doesn't support WHERE clauses.
  // See: prisma/migrations/add_pending_request_unique_index.sql
  @@map("join_requests")
}

// Advisory only — never auto-decides outcome
model JoinRequestOpinion {
  id              String   @id @default(cuid())
  join_request_id String
  team_member_id  String
  opinion         Opinion
  comment         String?
  created_at      DateTime @default(now())

  join_request    JoinRequest @relation(fields: [join_request_id], references: [id], onDelete: Cascade)
  team_member     User        @relation(fields: [team_member_id], references: [id], onDelete: Cascade)

  @@unique([join_request_id, team_member_id])
  @@map("join_request_opinions")
}

// ─────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────

model Notification {
  id          String                 @id @default(cuid())
  user_id     String
  team_id     String?                // Optional context reference
  type        NotificationType
  payload     Json                   // JSONB — structured per notification type
  read_status NotificationReadStatus @default(unread)
  created_at  DateTime               @default(now())

  user        User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team        Team? @relation(fields: [team_id], references: [id], onDelete: SetNull)

  @@index([user_id, read_status])
  @@map("notifications")
}
